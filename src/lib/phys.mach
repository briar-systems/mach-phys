# Public surface of mach-phys, the pure-Mach 2D/3D physics library.
#
# Implementation was sequenced behind Mach's built-in SIMD vector types so that
# no interim math shim would be written. Those types have since landed, so the
# vector math here is f32x4 directly.
#
# The library covers axis-aligned rigid bodies: semi-implicit integration,
# all-pairs broad phase, and impulse resolution with positional correction.
# Rotation, oriented shapes, joints, and continuous collision are not modelled.

use std.runtime;

fwd phys.vec;
fwd phys.body;
fwd phys.world;

# Major version component of the mach-phys library.
pub val VERSION_MAJOR: u32 = 0;
# Minor version component of the mach-phys library.
pub val VERSION_MINOR: u32 = 1;
# Patch version component of the mach-phys library.
pub val VERSION_PATCH: u32 = 0;

# The version components folded into one u32 as
# (major << 16) | (minor << 8) | patch.
pub fun packed_version() u32 {
    ret (VERSION_MAJOR << 16) | (VERSION_MINOR << 8) | VERSION_PATCH;
}
