# 3D vector math over Mach's f32x4.
#
# A Vec3 is an f32x4 with lane 3 unused. The fourth lane is carried rather than
# packed away, so the type maps to one register and the arithmetic operators
# apply directly.

use std.runtime;

# A 3D vector. Lane 3 is unused and must be treated as undefined.
pub def Vec3: f32x4;

# Construct a vector from its components.
pub fun vec3(x: f32, y: f32, z: f32) Vec3 {
    ret f32x4{x, y, z, 0.0};
}

# The zero vector.
pub fun zero3() Vec3 {
    ret f32x4{0.0, 0.0, 0.0, 0.0};
}

# Scale a vector by a scalar.
pub fun scale3(v: Vec3, s: f32) Vec3 {
    ret v * f32x4{s, s, s, 0.0};
}

# Dot product over the first three lanes.
pub fun dot3(a: Vec3, b: Vec3) f32 {
    val p: f32x4 = a * b;
    ret p[0] + p[1] + p[2];
}

# Squared length. Avoids the square root where only a comparison is needed.
pub fun length_sq3(v: Vec3) f32 {
    ret dot3(v, v);
}

# Component-wise minimum.
pub fun min3(a: Vec3, b: Vec3) Vec3 {
    var r: Vec3;
    r[0] = a[0];
    if (b[0] < a[0]) { r[0] = b[0]; }
    r[1] = a[1];
    if (b[1] < a[1]) { r[1] = b[1]; }
    r[2] = a[2];
    if (b[2] < a[2]) { r[2] = b[2]; }
    r[3] = 0.0;
    ret r;
}

# Component-wise maximum.
pub fun max3(a: Vec3, b: Vec3) Vec3 {
    var r: Vec3;
    r[0] = a[0];
    if (b[0] > a[0]) { r[0] = b[0]; }
    r[1] = a[1];
    if (b[1] > a[1]) { r[1] = b[1]; }
    r[2] = a[2];
    if (b[2] > a[2]) { r[2] = b[2]; }
    r[3] = 0.0;
    ret r;
}
